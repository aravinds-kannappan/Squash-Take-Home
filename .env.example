# Copy to .env and fill locally. Never commit real credentials.
# The Python driver loads this file; existing environment variables take priority.
# OpenAI takes priority when populated; never reuse a ChatGPT login token.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
RMM_URL=https://localhost:8443
RMM_API_KEY=
# Optional PEM CA bundle for the control plane (leave unset for system trust).
# RMM_CA_FILE=/absolute/path/to/ca.pem
# Docker Compose only: password for certs/server.pfx.
# RMM_CERT_PASSWORD=
